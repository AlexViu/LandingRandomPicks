---
import Layout from '../layouts/Layout.astro';
import { fetchGlobalTop, fetchMapTop, fetchMaps, fetchPlayerRank } from '../lib/ranking';
import type { MapRow, MapTimeRow, PlayerRow, TopRow } from '../lib/ranking';

// Se renderiza en cada petición (datos en vivo, con caché de 60 s en el servidor).
export const prerender = false;

const TOP_N = 50;
const search = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 64);
const mapParam = (Astro.url.searchParams.get('map') ?? '').trim();

let top: TopRow[] = [];
let maps: MapRow[] = [];
let mapTop: MapTimeRow[] = [];
let players: PlayerRow[] = [];
let selectedMap = '';
let failed = false;

try {
  [top, maps] = await Promise.all([fetchGlobalTop(TOP_N), fetchMaps()]);
  if (maps.some((m) => m.map === mapParam)) {
    selectedMap = mapParam;
    mapTop = await fetchMapTop(selectedMap, TOP_N);
  }
  if (search) players = await fetchPlayerRank(search);
} catch (err) {
  console.error('[ranking] error leyendo la base de datos de SharpTimer:', err);
  failed = true;
}

const medal = (pos: number) => (pos === 1 ? '🥇' : pos === 2 ? '🥈' : pos === 3 ? '🥉' : `#${pos}`);
const steamUrl = (id: string) => `https://steamcommunity.com/profiles/${id}`;
const fmt = (n: number) => n.toLocaleString('es-ES');

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Layout
  title="Ranking Bhop — RandomPicks CS2"
  description="Ranking global de bhop del servidor RandomPicks de CS2: puntos, mejores tiempos por mapa y búsqueda de jugadores. Actualizado en directo."
>
  <nav>
    <div class="nav-inner">
      <a href="/" class="logo-img-link">
        <img src="/random_picks_logo.jpg" alt="RandomPicks" style="height:44px;width:72px;object-fit:cover;object-position:center;border-radius:8px;display:block;" />
      </a>
      <div class="nav-right">
        <a href="/" class="nav-back" data-i18n="rk-back">← Volver al inicio</a>
        <button id="lang-toggle" class="lang-toggle" aria-label="Switch to English" title="Switch to English">
          <span class="lang-globe" aria-hidden="true">🌐</span>
          <span class="lang-es lang-active" id="lang-es">ES</span>
          <span class="lang-sep" aria-hidden="true">|</span>
          <span class="lang-en lang-inactive" id="lang-en">EN</span>
        </button>
      </div>
    </div>
  </nav>

  <main class="ranking-page">
    <header class="rk-header">
      <div class="section-tag" data-i18n="rk-tag">RANKING BHOP</div>
      <h1 class="rk-title" data-i18n="rk-title">Los más rápidos del servidor</h1>
      <p class="rk-sub" data-i18n="rk-sub">
        En cada mapa, el mejor tiempo suma 1000 puntos y el resto, menos según su puesto. Es el mismo ranking que el bot de Discord.
      </p>
    </header>

    {failed ? (
      <div class="rk-card rk-empty" data-i18n="rk-error">
        El ranking no está disponible ahora mismo. Vuelve a intentarlo en unos minutos.
      </div>
    ) : (
      <>
        <form class="rk-search" method="get" action="/ranking">
          <input
            type="search" name="q" value={search} maxlength="64"
            placeholder="Busca un jugador o SteamID64" data-i18n-placeholder="rk-search-ph"
            aria-label="Buscar jugador"
          />
          {selectedMap && <input type="hidden" name="map" value={selectedMap} />}
          <button type="submit" data-i18n="rk-search-btn">Buscar</button>
        </form>

        {search && (
          <section class="rk-card">
            <h2 class="rk-card-title"><span data-i18n="rk-results">Resultados para</span> “{search}”</h2>
            {players.length === 0 ? (
              <p class="rk-empty-line" data-i18n="rk-no-player">No hay ningún jugador con ese nombre en el ranking.</p>
            ) : (
              <table class="rk-table">
                <thead><tr><th>#</th><th data-i18n="rk-col-player">Jugador</th><th class="num" data-i18n="rk-col-points">Puntos</th></tr></thead>
                <tbody>
                  {players.map((p) => (
                    <tr>
                      <td class="pos">{medal(p.position)}</td>
                      <td><a href={steamUrl(p.steamId)} target="_blank" rel="noopener">{p.name}</a></td>
                      <td class="num">{fmt(p.points)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </section>
        )}

        <div class="rk-grid">
          <section class="rk-card">
            <h2 class="rk-card-title" data-i18n="rk-global">Ranking global</h2>
            {top.length === 0 ? (
              <p class="rk-empty-line" data-i18n="rk-no-records">Todavía no hay tiempos registrados.</p>
            ) : (
              <table class="rk-table">
                <thead><tr><th>#</th><th data-i18n="rk-col-player">Jugador</th><th class="num" data-i18n="rk-col-points">Puntos</th></tr></thead>
                <tbody>
                  {top.map((p, i) => (
                    <tr class={i < 3 ? 'podium' : ''}>
                      <td class="pos">{medal(i + 1)}</td>
                      <td><a href={steamUrl(p.steamId)} target="_blank" rel="noopener">{p.name}</a></td>
                      <td class="num">{fmt(p.points)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </section>

          <section class="rk-card">
            <h2 class="rk-card-title" data-i18n="rk-by-map">Mejores tiempos por mapa</h2>
            <form class="rk-map-form" method="get" action="/ranking">
              <select name="map" aria-label="Mapa" onchange="this.form.submit()">
                <option value="" data-i18n="rk-pick-map">Elige un mapa…</option>
                {maps.map((m) => (
                  <option value={m.map} selected={m.map === selectedMap}>{m.map} ({m.players})</option>
                ))}
              </select>
              {search && <input type="hidden" name="q" value={search} />}
              <noscript><button type="submit">OK</button></noscript>
            </form>
            {selectedMap ? (
              mapTop.length === 0 ? (
                <p class="rk-empty-line" data-i18n="rk-no-records">Todavía no hay tiempos registrados.</p>
              ) : (
                <table class="rk-table">
                  <thead><tr><th>#</th><th data-i18n="rk-col-player">Jugador</th><th class="num" data-i18n="rk-col-time">Tiempo</th><th class="num" data-i18n="rk-col-finishes">Completado</th></tr></thead>
                  <tbody>
                    {mapTop.map((r, i) => (
                      <tr class={i < 3 ? 'podium' : ''}>
                        <td class="pos">{medal(i + 1)}</td>
                        <td>{r.name}</td>
                        <td class="num mono">{r.time}</td>
                        <td class="num">{r.finishes}×</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )
            ) : (
              <p class="rk-empty-line" data-i18n="rk-map-hint">Selecciona un mapa para ver su top de tiempos.</p>
            )}
          </section>
        </div>
      </>
    )}

    <p class="rk-footnote">
      <span data-i18n="rk-footnote">Se actualiza cada minuto · Conéctate y entra en el ranking:</span>
      <code>connect cs2.randompicks.es:27015</code>
    </p>
  </main>

  <script is:inline>
    var t = {
      es: {
        'rk-back': '← Volver al inicio', 'rk-tag': 'RANKING BHOP', 'rk-title': 'Los más rápidos del servidor',
        'rk-sub': 'En cada mapa, el mejor tiempo suma 1000 puntos y el resto, menos según su puesto. Es el mismo ranking que el bot de Discord.',
        'rk-error': 'El ranking no está disponible ahora mismo. Vuelve a intentarlo en unos minutos.',
        'rk-search-ph': 'Busca un jugador o SteamID64', 'rk-search-btn': 'Buscar', 'rk-results': 'Resultados para',
        'rk-no-player': 'No hay ningún jugador con ese nombre en el ranking.',
        'rk-global': 'Ranking global', 'rk-by-map': 'Mejores tiempos por mapa', 'rk-pick-map': 'Elige un mapa…',
        'rk-map-hint': 'Selecciona un mapa para ver su top de tiempos.', 'rk-no-records': 'Todavía no hay tiempos registrados.',
        'rk-col-player': 'Jugador', 'rk-col-points': 'Puntos', 'rk-col-time': 'Tiempo', 'rk-col-finishes': 'Completado',
        'rk-footnote': 'Se actualiza cada minuto · Conéctate y entra en el ranking:',
      },
      en: {
        'rk-back': '← Back to home', 'rk-tag': 'BHOP RANKING', 'rk-title': 'The fastest players on the server',
        'rk-sub': 'On each map the best time is worth 1000 points and the rest get less depending on their position. Same ranking as the Discord bot.',
        'rk-error': 'The ranking is not available right now. Please try again in a few minutes.',
        'rk-search-ph': 'Search a player or SteamID64', 'rk-search-btn': 'Search', 'rk-results': 'Results for',
        'rk-no-player': 'No player with that name in the ranking.',
        'rk-global': 'Global ranking', 'rk-by-map': 'Best times by map', 'rk-pick-map': 'Pick a map…',
        'rk-map-hint': 'Select a map to see its top times.', 'rk-no-records': 'No times recorded yet.',
        'rk-col-player': 'Player', 'rk-col-points': 'Points', 'rk-col-time': 'Time', 'rk-col-finishes': 'Finished',
        'rk-footnote': 'Updated every minute · Connect and join the ranking:',
      },
    };

    function applyLang(lang) {
      var dict = t[lang];
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (dict[key] !== undefined) el.textContent = dict[key];
      });
      document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-placeholder');
        if (dict[key] !== undefined) el.setAttribute('placeholder', dict[key]);
      });
      var esEl = document.getElementById('lang-es');
      var enEl = document.getElementById('lang-en');
      var btn  = document.getElementById('lang-toggle');
      var on = lang === 'es' ? esEl : enEl, off = lang === 'es' ? enEl : esEl;
      on.classList.add('lang-active');   on.classList.remove('lang-inactive');
      off.classList.add('lang-inactive'); off.classList.remove('lang-active');
      var label = lang === 'es' ? 'Switch to English' : 'Cambiar a Español';
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
      document.documentElement.setAttribute('lang', lang);
    }

    var currentLang = (function() {
      var s = null;
      try { s = localStorage.getItem('rp-lang'); } catch (_) {}
      if (s === 'es' || s === 'en') return s;
      return navigator.language.startsWith('es') ? 'es' : 'en';
    })();
    if (currentLang !== 'es') applyLang(currentLang);

    document.getElementById('lang-toggle').addEventListener('click', function() {
      currentLang = currentLang === 'es' ? 'en' : 'es';
      try { localStorage.setItem('rp-lang', currentLang); } catch (_) {}
      applyLang(currentLang);
    });
  </script>
</Layout>

<style>
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(10,10,15,0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 24px;
    height: 64px; display: flex; align-items: center; justify-content: space-between;
  }
  .logo-img-link { display: flex; align-items: center; text-decoration: none; }
  .nav-right { display: flex; align-items: center; gap: 16px; }
  .nav-back { color: var(--muted); text-decoration: none; font-size: 0.88rem; font-weight: 500; transition: color 0.2s; }
  .nav-back:hover { color: var(--text); }
  .lang-toggle {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 8px;
    padding: 5px 11px; cursor: pointer; font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.07em; color: var(--text); transition: border-color 0.2s, background 0.2s; outline: none;
  }
  .lang-toggle:hover { border-color: rgba(255,255,255,0.18); background: rgba(255,255,255,0.07); }
  .lang-toggle:focus-visible { border-color: var(--orange); box-shadow: 0 0 0 2px rgba(255,107,43,0.3); }
  .lang-globe { font-size: 0.85rem; }
  .lang-active { color: var(--text); }
  .lang-sep { color: var(--border); font-weight: 400; }
  .lang-inactive { color: var(--muted); transition: color 0.15s; }
  .lang-toggle:hover .lang-inactive { color: var(--text); }

  .ranking-page { max-width: 1200px; margin: 0 auto; padding: 112px 24px 72px; }
  .rk-header { text-align: center; margin-bottom: 40px; animation: fadeInUp 0.6s ease both; }
  .section-tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; color: var(--orange); margin-bottom: 12px; }
  .rk-title { font-size: clamp(2rem, 4vw, 3rem); color: var(--text); margin-bottom: 12px; line-height: 1.1; }
  .rk-sub { color: var(--muted); max-width: 560px; margin: 0 auto; }

  .rk-search { display: flex; gap: 10px; max-width: 560px; margin: 0 auto 32px; }
  .rk-search input, .rk-map-form select {
    flex: 1; min-width: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    color: var(--text); font: inherit; padding: 11px 14px; outline: none; transition: border-color 0.2s;
  }
  .rk-search input:focus, .rk-map-form select:focus { border-color: var(--orange); }
  .rk-search button {
    background: var(--orange); color: #fff; border: none; border-radius: 10px; padding: 0 22px;
    font: inherit; font-weight: 600; cursor: pointer; transition: background 0.2s;
  }
  .rk-search button:hover { background: var(--orange-dim); }

  .rk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
  .rk-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    padding: 24px; margin-bottom: 20px; animation: fadeInUp 0.6s ease both;
  }
  .rk-grid .rk-card { margin-bottom: 0; }
  .rk-card-title { font-size: 1.35rem; color: var(--text); margin-bottom: 16px; }
  .rk-map-form { display: flex; margin-bottom: 16px; }
  .rk-map-form select { cursor: pointer; }
  .rk-empty { text-align: center; color: var(--muted); padding: 48px 24px; }
  .rk-empty-line { color: var(--muted); font-size: 0.92rem; }

  .rk-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .rk-table th {
    text-align: left; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); padding: 0 10px 10px; border-bottom: 1px solid var(--border);
  }
  .rk-table td { padding: 10px; border-bottom: 1px solid var(--border); overflow-wrap: anywhere; }
  .rk-table tr:last-child td { border-bottom: none; }
  .rk-table tbody tr:hover { background: var(--surface2); }
  .rk-table .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .rk-table .mono { font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; }
  .rk-table .pos { width: 48px; color: var(--muted); font-weight: 600; white-space: nowrap; }
  .rk-table .podium td { font-weight: 600; }
  .rk-table .podium .num:last-child { color: var(--orange); }
  .rk-table a { color: var(--text); text-decoration: none; }
  .rk-table a:hover { color: var(--orange); }

  .rk-footnote { text-align: center; color: var(--muted); font-size: 0.85rem; margin-top: 40px; }
  .rk-footnote code { color: var(--orange); margin-left: 6px; }

  @media (max-width: 900px) {
    .rk-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .nav-inner { padding: 0 16px; }
    .lang-sep, .lang-inactive { display: none; }
    .ranking-page { padding: 96px 16px 56px; }
    .rk-card { padding: 18px 14px; }
    .rk-table { font-size: 0.85rem; }
    .rk-table th, .rk-table td { padding-left: 6px; padding-right: 6px; }
    .rk-footnote code { display: block; margin: 6px 0 0; }
  }
</style>
