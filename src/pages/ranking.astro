---
import Layout from '../layouts/Layout.astro';
import { fetchGlobalTop, fetchMapTop, fetchMaps, fetchPlayerPbOnMap, fetchPlayerRank } from '../lib/ranking';
import type { MapRow, MapTimeRow, PbRow, PlayerRow, TopRow } from '../lib/ranking';

// Se renderiza en cada petición (datos en vivo, con caché de 60 s en el servidor).
export const prerender = false;

// Mismo formato que las respuestas del bot de Discord (sharptimer-bot): cada bloque
// replica un comando (/top, /rank, /maptop, /pb, /maps) con sus textos y colores.
const TOP_N = 10; // DEFAULT_TOP_N del bot
const search = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 64);
const mapParam = (Astro.url.searchParams.get('map') ?? '').trim().slice(0, 128);

let top: TopRow[] = [];
let maps: MapRow[] = [];
let mapTop: MapTimeRow[] = [];
let pbs: PbRow[] = [];
let players: PlayerRow[] = [];
let suggestions: string[] = [];
let failed = false;

try {
  [top, maps] = await Promise.all([fetchGlobalTop(TOP_N), fetchMaps()]);
  if (mapParam) {
    if (maps.some((m) => m.map === mapParam)) {
      mapTop = await fetchMapTop(mapParam, TOP_N);
      if (search) pbs = await fetchPlayerPbOnMap(mapParam, search);
    } else {
      suggestions = maps.map((m) => m.map).filter((m) => m.toLowerCase().includes(mapParam.toLowerCase())).slice(0, 5);
    }
  } else if (search) {
    players = await fetchPlayerRank(search);
  }
} catch (err) {
  console.error('[ranking] error leyendo la base de datos de SharpTimer:', err);
  failed = true;
}

const MEDALS = ['🥇', '🥈', '🥉'];
const mapHref = (m: string) => `/ranking?map=${encodeURIComponent(m)}`;

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Layout
  title="Ranking Bhop — RandomPicks CS2"
  description="Ranking global de bhop del servidor RandomPicks de CS2: puntos, mejores tiempos por mapa y búsqueda de jugadores. El mismo ranking que el bot de Discord, en directo."
>
  <nav>
    <div class="nav-inner">
      <a href="/" class="logo-img-link">
        <img src="/random_picks_logo.jpg" alt="RandomPicks" style="height:44px;width:72px;object-fit:cover;object-position:center;border-radius:8px;display:block;" />
      </a>
      <div class="nav-right">
        <a href="/" class="nav-back" data-i18n="rk-back">← Volver al inicio</a>
        <button id="lang-toggle" class="lang-toggle" aria-label="Switch to English" title="Switch to English">
          <span class="lang-globe" aria-hidden="true">🌐</span>
          <span class="lang-es lang-active" id="lang-es">ES</span>
          <span class="lang-sep" aria-hidden="true">|</span>
          <span class="lang-en lang-inactive" id="lang-en">EN</span>
        </button>
      </div>
    </div>
  </nav>

  <main class="ranking-page">
    <header class="rk-header">
      <div class="section-tag" data-i18n="rk-tag">RANKING BHOP</div>
      <h1 class="rk-title" data-i18n="rk-title">Los más rápidos del servidor</h1>
      <p class="rk-sub" data-i18n="rk-sub">
        El mismo ranking que el bot de Discord (/top, /maptop, /pb, /rank y /maps), en directo desde el servidor.
      </p>
    </header>

    <form class="rk-search" method="get" action="/ranking">
      <input
        type="search" name="q" value={search} maxlength="64"
        placeholder="Jugador o SteamID64" data-i18n-placeholder="rk-search-ph" aria-label="Jugador"
      />
      <select name="map" aria-label="Mapa">
        <option value="" data-i18n="rk-all-maps">Todos los mapas</option>
        {maps.map((m) => <option value={m.map} selected={m.map === mapParam}>{m.map}</option>)}
      </select>
      <button type="submit" data-i18n="rk-search-btn">Buscar</button>
      {(search || mapParam) && <a class="rk-clear" href="/ranking" data-i18n="rk-clear">Limpiar</a>}
    </form>

    {failed ? (
      <div class="embed" style="--accent: #ed4245">
        <p class="embed-desc">Error leyendo la base. El ranking no está disponible ahora mismo, vuelve a intentarlo en unos minutos.</p>
      </div>
    ) : (
      <div class="rk-grid">
        <div class="rk-col">
          {/* /rank <jugador> */}
          {search && !mapParam && (
            players.length === 0 ? (
              <div class="embed-msg">No encontré a ningún jugador que coincida con <code>{search}</code>.</div>
            ) : players.length === 1 ? (
              <div class="embed-msg">
                <strong>{players[0].name}</strong> está en la posición <strong>#{players[0].position}</strong> con <strong>{players[0].points} puntos</strong>.
              </div>
            ) : (
              <div class="embed-msg">
                Encontré {players.length} jugadores que coinciden con <code>{search}</code>, sé más específico:
                {players.map((p) => (
                  <div class="line"><code>#{p.position}</code> <strong>{p.name}</strong> — {p.points} pts</div>
                ))}
              </div>
            )
          )}

          {/* /top */}
          <section class="embed" style="--accent: #f1c40f">
            <h2 class="embed-title">🏆 Ranking Global - SharpTimer</h2>
            {top.length === 0 ? (
              <p class="embed-desc">No hay datos todavía.</p>
            ) : (
              <>
                <div class="embed-desc">
                  {top.map((p, i) => (
                    <div class="line">
                      {i < 3 ? MEDALS[i] : <code>#{i + 1}</code>} <strong>{p.name || 'Desconocido'}</strong> — {p.points} pts
                    </div>
                  ))}
                </div>
                <p class="embed-footer">Mostrando top {top.length} | Puntos por posición relativa en cada mapa</p>
              </>
            )}
          </section>
        </div>

        <div class="rk-col">
          {/* /pb <mapa> <jugador> */}
          {mapParam && search && mapTop.length > 0 && (
            pbs.length === 0 ? (
              <div class="embed-msg">No encontré ningún tiempo de <code>{search}</code> en el mapa <code>{mapParam}</code>.</div>
            ) : pbs.length === 1 ? (
              <div class="embed-msg">
                <strong>{pbs[0].name}</strong> en <code>{mapParam}</code>: <strong>{pbs[0].time}</strong> — posición <strong>#{pbs[0].position}/{pbs[0].total}</strong> ({pbs[0].finishes} runs)
              </div>
            ) : (
              <div class="embed-msg">
                Encontré {pbs.length} jugadores que coinciden con <code>{search}</code> en <code>{mapParam}</code>, sé más específico:
                {pbs.map((p) => (
                  <div class="line"><code>#{p.position}/{p.total}</code> <strong>{p.name}</strong> — {p.time}</div>
                ))}
              </div>
            )
          )}

          {/* /maptop <mapa> */}
          {mapParam && (
            mapTop.length === 0 ? (
              <div class="embed-msg">
                No encontré records para el mapa <code>{mapParam}</code>.
                {suggestions.length > 0 && (
                  <div class="line">¿Quizás quisiste decir: {suggestions.map((m, i) => (<>{i > 0 && ', '}<a href={mapHref(m)}>{m}</a></>))}?</div>
                )}
              </div>
            ) : (
              <section class="embed" style="--accent: #3498db">
                <h2 class="embed-title">⏱️ Top tiempos - {mapParam}</h2>
                <div class="embed-desc">
                  {mapTop.map((r, i) => (
                    <div class="line">
                      {i < 3 ? MEDALS[i] : <code>#{i + 1}</code>} <strong>{r.name || 'Desconocido'}</strong> — {r.time} ({r.finishes} runs)
                    </div>
                  ))}
                </div>
              </section>
            )
          )}

          {/* /maps */}
          <section class="embed" style="--accent: #2ecc71">
            <h2 class="embed-title">🗺️ Mapas con records ({maps.length} en total)</h2>
            {maps.length === 0 ? (
              <p class="embed-desc">No hay mapas con records todavía.</p>
            ) : (
              <>
                <div class="embed-desc maps-list">
                  {maps.map((m) => (
                    <div class="line">
                      <a href={mapHref(m.map)} class={m.map === mapParam ? 'active' : ''}><strong>{m.map}</strong></a> — {m.players} jugador{m.players !== 1 ? 'es' : ''}
                    </div>
                  ))}
                </div>
                <p class="embed-footer" data-i18n="rk-maps-hint">Pulsa un mapa para ver su top de tiempos</p>
              </>
            )}
          </section>
        </div>
      </div>
    )}

    <p class="rk-footnote">
      <span data-i18n="rk-footnote">Se actualiza cada minuto · Conéctate y entra en el ranking:</span>
      <code>connect cs2.randompicks.es:27015</code>
    </p>
  </main>

  <script is:inline>
    var t = {
      es: {
        'rk-back': '← Volver al inicio', 'rk-tag': 'RANKING BHOP', 'rk-title': 'Los más rápidos del servidor',
        'rk-sub': 'El mismo ranking que el bot de Discord (/top, /maptop, /pb, /rank y /maps), en directo desde el servidor.',
        'rk-search-ph': 'Jugador o SteamID64', 'rk-all-maps': 'Todos los mapas', 'rk-search-btn': 'Buscar', 'rk-clear': 'Limpiar',
        'rk-maps-hint': 'Pulsa un mapa para ver su top de tiempos',
        'rk-footnote': 'Se actualiza cada minuto · Conéctate y entra en el ranking:',
      },
      en: {
        'rk-back': '← Back to home', 'rk-tag': 'BHOP RANKING', 'rk-title': 'The fastest players on the server',
        'rk-sub': 'The same ranking as the Discord bot (/top, /maptop, /pb, /rank and /maps), live from the server.',
        'rk-search-ph': 'Player or SteamID64', 'rk-all-maps': 'All maps', 'rk-search-btn': 'Search', 'rk-clear': 'Clear',
        'rk-maps-hint': 'Click a map to see its top times',
        'rk-footnote': 'Updated every minute · Connect and join the ranking:',
      },
    };

    function applyLang(lang) {
      var dict = t[lang];
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (dict[key] !== undefined) el.textContent = dict[key];
      });
      document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-placeholder');
        if (dict[key] !== undefined) el.setAttribute('placeholder', dict[key]);
      });
      var esEl = document.getElementById('lang-es');
      var enEl = document.getElementById('lang-en');
      var btn  = document.getElementById('lang-toggle');
      var on = lang === 'es' ? esEl : enEl, off = lang === 'es' ? enEl : esEl;
      on.classList.add('lang-active');   on.classList.remove('lang-inactive');
      off.classList.add('lang-inactive'); off.classList.remove('lang-active');
      var label = lang === 'es' ? 'Switch to English' : 'Cambiar a Español';
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
      document.documentElement.setAttribute('lang', lang);
    }

    var currentLang = (function() {
      var s = null;
      try { s = localStorage.getItem('rp-lang'); } catch (_) {}
      if (s === 'es' || s === 'en') return s;
      return navigator.language.startsWith('es') ? 'es' : 'en';
    })();
    if (currentLang !== 'es') applyLang(currentLang);

    document.getElementById('lang-toggle').addEventListener('click', function() {
      currentLang = currentLang === 'es' ? 'en' : 'es';
      try { localStorage.setItem('rp-lang', currentLang); } catch (_) {}
      applyLang(currentLang);
    });
  </script>
</Layout>

<style>
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(10,10,15,0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 24px;
    height: 64px; display: flex; align-items: center; justify-content: space-between;
  }
  .logo-img-link { display: flex; align-items: center; text-decoration: none; }
  .nav-right { display: flex; align-items: center; gap: 16px; }
  .nav-back { color: var(--muted); text-decoration: none; font-size: 0.88rem; font-weight: 500; transition: color 0.2s; }
  .nav-back:hover { color: var(--text); }
  .lang-toggle {
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 8px;
    padding: 5px 11px; cursor: pointer; font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.07em; color: var(--text); transition: border-color 0.2s, background 0.2s; outline: none;
  }
  .lang-toggle:hover { border-color: rgba(255,255,255,0.18); background: rgba(255,255,255,0.07); }
  .lang-toggle:focus-visible { border-color: var(--orange); box-shadow: 0 0 0 2px rgba(255,107,43,0.3); }
  .lang-globe { font-size: 0.85rem; }
  .lang-active { color: var(--text); }
  .lang-sep { color: var(--border); font-weight: 400; }
  .lang-inactive { color: var(--muted); transition: color 0.15s; }
  .lang-toggle:hover .lang-inactive { color: var(--text); }

  .ranking-page { max-width: 1200px; margin: 0 auto; padding: 112px 24px 72px; }
  .rk-header { text-align: center; margin-bottom: 36px; animation: fadeInUp 0.6s ease both; }
  .section-tag { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; color: var(--orange); margin-bottom: 12px; }
  .rk-title { font-size: clamp(2rem, 4vw, 3rem); color: var(--text); margin-bottom: 12px; line-height: 1.1; }
  .rk-sub { color: var(--muted); max-width: 580px; margin: 0 auto; }

  .rk-search { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; max-width: 760px; margin: 0 auto 32px; }
  .rk-search input, .rk-search select {
    flex: 1 1 200px; min-width: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    color: var(--text); font: inherit; padding: 11px 14px; outline: none; transition: border-color 0.2s;
  }
  .rk-search select { cursor: pointer; }
  .rk-search input:focus, .rk-search select:focus { border-color: var(--orange); }
  .rk-search button {
    background: var(--orange); color: #fff; border: none; border-radius: 10px; padding: 11px 22px;
    font: inherit; font-weight: 600; cursor: pointer; transition: background 0.2s;
  }
  .rk-search button:hover { background: var(--orange-dim); }
  .rk-clear { color: var(--muted); font-size: 0.88rem; text-decoration: none; }
  .rk-clear:hover { color: var(--text); }

  .rk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
  .rk-col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

  /* ── Embeds al estilo Discord ── */
  .embed, .embed-msg {
    --embed-bg: #2b2d31;
    background: var(--embed-bg); border-radius: 4px; color: #dbdee1;
    font-size: 0.95rem; line-height: 1.55; overflow-wrap: anywhere;
    animation: fadeInUp 0.5s ease both;
  }
  .embed { border-left: 4px solid var(--accent); padding: 12px 16px 14px 12px; }
  .embed-msg { background: transparent; padding: 4px 2px; }
  .embed-title { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 700; color: #f2f3f5; letter-spacing: 0; margin-bottom: 8px; }
  .embed-desc .line, .embed-msg .line { margin-top: 2px; }
  .embed strong, .embed-msg strong { color: #f2f3f5; font-weight: 700; }
  .embed code, .embed-msg code {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace; font-size: 0.85em;
    background: #1e1f22; border-radius: 3px; padding: 1px 4px;
  }
  .embed-footer { margin-top: 8px; font-size: 0.75rem; color: #949ba4; }
  .embed a, .embed-msg a { color: #00a8fc; text-decoration: none; }
  .embed a:hover, .embed-msg a:hover { text-decoration: underline; }
  .embed a strong { color: inherit; }
  .embed a.active strong { color: var(--orange); }
  .maps-list { max-height: 520px; overflow-y: auto; padding-right: 6px; }

  .rk-footnote { text-align: center; color: var(--muted); font-size: 0.85rem; margin-top: 40px; }
  .rk-footnote code { color: var(--orange); margin-left: 6px; }

  @media (max-width: 900px) {
    .rk-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .nav-inner { padding: 0 16px; }
    .lang-sep, .lang-inactive { display: none; }
    .ranking-page { padding: 96px 16px 56px; }
    .embed { font-size: 0.9rem; }
    .rk-footnote code { display: block; margin: 6px 0 0; }
  }
</style>
