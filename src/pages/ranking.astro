        'ach-cmd-title': 'Comandos en el juego', 'ach-cmd-1': 'Tus logros y tu progreso',
        'ach-cmd-2': 'Los mejores jugadores por puntos de logros', 'ach-cmd-3': 'Muestra u oculta el seguimiento de logros en pantalla',
      },
      en: {
        'ad-label': 'Advertisement', 'footer-privacy': 'Privacy',
        'nav-home': 'Home', 'nav-guides': 'Guides', 'nav-maps': 'Maps', 'nav-news': 'News', 'nav-kofi': '☕ Support us', 'menu-label': 'Menu', 'rk-tag': 'MINIGAMES RANKING', 'rk-title': 'The fastest players on the server',
        'rk-sub': 'Global top 20 by points. Pick a map to see only its records.',
        'rk-map-label': 'Map', 'rk-search-label': 'Player',
        'rk-search-ph': 'Name or SteamID64', 'rk-all-maps': '🏆 Global ranking', 'rk-search-btn': 'Search', 'rk-clear': 'Clear',
        'rk-kind-map': '⏱️ Map records', 'rk-kind-global': '🏆 Global ranking',
        'rk-results': 'results', 'rk-players': 'players',
        'rk-col-player': 'Player', 'rk-col-time': 'Time', 'rk-col-points': 'Points',
        'rk-error': 'The ranking is not available right now. Please try again in a few minutes.',
        'rk-no-map': 'No records for map', 'rk-maybe': 'Did you mean?',
        'rk-no-player': 'No player matches', 'rk-no-data': 'No data yet.',
        'rk-foot-map': "Each player's best time on this map", 'rk-foot-global': 'Points based on relative position on each map',
        'rk-footnote': 'Updated every minute · Connect and join the ranking:',
        'rk-tag-ach': 'ACHIEVEMENTS RANKING', 'rk-title-ach': 'Achievement hunters',
        'rk-unknown': 'Unknown', 'rk-tab-times': '⏱️ Times', 'rk-tab-ach': '🏅 Achievements', 'rk-kind-ach': '🏅 Achievements ranking',
        'rk-sub-ach': 'Top 20 by achievement points. Unlock them playing on Minigames and Surf.',
        'rk-no-ach': 'Nobody has achievements yet. Be the first!', 'rk-foot-ach': 'Achievement points · 🏅 achievements unlocked',
        'ach-how-title': 'How do achievements work?',
        'ach-how-intro': 'Every time you finish a map with the timer running, the server checks your achievements. Unlock one and you earn its points, a sound plays and the whole server finds out. Your achievements are saved forever and count the same on Minigames and Surf.',
        'ach-1-t': '🏁 Runs', 'ach-1-d': 'Finish maps: your first one, 10, 50, 250… all the way to 1000 runs.',
        'ach-2-t': '🗺️ Exploration', 'ach-2-d': 'Finish different maps, bonuses and high-tier maps.',
        'ach-3-t': '⚡ Speed', 'ach-3-d': 'Finish in under 1 minute or 30 seconds, and reach 1000 or 2500 u/s.',
        'ach-4-t': '🥇 Competition', 'ach-4-d': 'Beat your personal bests, make a map\'s top 10 or podium and set server records.',
        'ach-5-t': '🎯 Technique', 'ach-5-d': 'Finish with 90% sync or with a style other than normal.',
        'ach-6-t': '⏳ Dedication', 'ach-6-d': 'Hours played, jumps, connections and marathons without leaving the server.',
        'ach-7-t': '❓ Secrets', 'ach-7-d': 'Some achievements stay hidden until you get them. Can you find them?',
        'ach-how-points': 'Harder achievements give more points. The ranking sorts by points and, on a tie, by number of achievements.',
        'ach-cmd-title': 'In-game commands', 'ach-cmd-1': 'Your achievements and progress',
        'ach-cmd-2': 'Top players by achievement points', 'ach-cmd-3': 'Show or hide the on-screen achievement tracker',
      },
    };

    function applyLang(lang) {
      var dict = t[lang];
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        var key = el.getAttribute('data-i18n');
        if (dict[key] !== undefined) el.textContent = dict[key];
      });
      document.querySelectorAll('[data-i18n-aria-label]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-aria-label');
        if (dict[key] !== undefined) el.setAttribute('aria-label', dict[key]);
      });
      document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
        var key = el.getAttribute('data-i18n-placeholder');
        if (dict[key] !== undefined) el.setAttribute('placeholder', dict[key]);
      });
      var esEl = document.getElementById('lang-es');
      var enEl = document.getElementById('lang-en');
      var btn  = document.getElementById('lang-toggle');
      var on = lang === 'es' ? esEl : enEl, off = lang === 'es' ? enEl : esEl;
      on.classList.add('lang-active');   on.classList.remove('lang-inactive');
      off.classList.add('lang-inactive'); off.classList.remove('lang-active');
      var label = lang === 'es' ? 'Switch to English' : 'Cambiar a Español';
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
      document.documentElement.setAttribute('lang', lang);
    }

    var currentLang = (function() {
      var s = null;
      try { s = localStorage.getItem('rp-lang'); } catch (_) {}
      if (s === 'es' || s === 'en') return s;
      return navigator.language.startsWith('es') ? 'es' : 'en';
    })();
    if (currentLang !== 'es') applyLang(currentLang);

    document.getElementById('lang-toggle').addEventListener('click', function() {
      currentLang = currentLang === 'es' ? 'en' : 'es';
      try { localStorage.setItem('rp-lang', currentLang); } catch (_) {}
      applyLang(currentLang);
    });

    var hamburger  = document.getElementById('hamburger');
    var mobileMenu = document.getElementById('mobile-menu');
    hamburger.addEventListener('click', function() {
      var open = mobileMenu.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    // Al cambiar de mapa se carga directamente su lista (sin JS, sirve el botón Buscar).
    var mapSelect = document.getElementById('rk-map');
    if (mapSelect) mapSelect.addEventListener('change', function() { mapSelect.form.submit(); });
  </script>
</Layout>

