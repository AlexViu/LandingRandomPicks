        'rk-results': 'resultados', 'rk-players': 'jugadores',
        'rk-col-player': 'Jugador', 'rk-col-time': 'Tiempo', 'rk-col-points': 'Puntos',
        'rk-error': 'El ranking no está disponible ahora mismo. Vuelve a intentarlo en unos minutos.',
        'rk-no-map': 'No hay records para el mapa', 'rk-maybe': '¿Quizás quisiste decir?',
        'rk-no-player': 'Ningún jugador coincide con', 'rk-no-data': 'Todavía no hay datos.',
        'rk-foot-map': 'Mejor tiempo de cada jugador en este mapa', 'rk-foot-global': 'Puntos por posición relativa en cada mapa',
        'rk-footnote': 'Se actualiza cada minuto · Conéctate y entra en el ranking:',
        'rk-tag-ach': 'RANKING DE LOGROS', 'rk-title-ach': 'Cazadores de logros',
        'rk-unknown': 'Desconocido', 'rk-tab-times': '⏱️ Tiempos', 'rk-tab-ach': '🏅 Logros', 'rk-kind-ach': '🏅 Ranking de logros',
        'rk-sub-ach': 'Top 20 por puntos de logros. Desbloquéalos jugando en Minigames y Surf.',
        'rk-no-ach': 'Nadie tiene logros todavía. ¡Sé el primero!', 'rk-foot-ach': 'Puntos de logros · 🏅 logros desbloqueados',
        'ach-how-title': '¿Cómo funcionan los logros?',
        'ach-how-intro': 'Cada vez que completas un mapa con el cronómetro, el servidor revisa tus logros. Al desbloquear uno ganas sus puntos, suena un aviso y todo el servidor se entera. Tus logros se guardan para siempre y valen igual en Minigames y en Surf.',
        'ach-1-t': '🏁 Recorridos', 'ach-1-d': 'Completa mapas: el primero, 10, 50, 250… y hasta 1000 recorridos.',
        'ach-2-t': '🗺️ Exploración', 'ach-2-d': 'Completa mapas distintos, bonus y mapas de tier alto.',
