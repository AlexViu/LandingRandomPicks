---
import Layout from '../layouts/Layout.astro';
import Analytics from '../components/Analytics.astro';
import { fetchAchievementsRank, fetchAchievementsTop, fetchGlobalTop, fetchMapTop, fetchMaps, fetchPlayerPbOnMap, fetchPlayerRank } from '../lib/ranking';
import type { MapRow } from '../lib/ranking';

// Se renderiza en cada petición (datos en vivo, con caché de 60 s en el servidor).
export const prerender = false;

// Una sola lista: el ranking global (puntos) o, si se filtra por mapa, solo los
// records de ese mapa. El buscador filtra dentro de la lista que se está viendo.
const LIMIT = 20;
const search = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 64);
// ?view=logros: ranking de puntos de logros (CourseAchievements) en vez del de tiempos.
const achievements = Astro.url.searchParams.get('view') === 'logros';
const mapParam = achievements ? '' : (Astro.url.searchParams.get('map') ?? '').trim().slice(0, 128);

interface Row { pos: number; name: string; value: string; extra?: string; total?: number; }

let maps: MapRow[] = [];
let rows: Row[] = [];
let mapTotal = 0;          // jugadores con record en el mapa elegido
let suggestions: string[] = [];
let failed = false;

try {
  maps = achievements ? [] : await fetchMaps();
  const selected = mapParam ? maps.find((m) => m.map === mapParam) : undefined;

  if (achievements) {
    rows = (search ? await fetchAchievementsRank(search) : await fetchAchievementsTop(LIMIT))
      .map((r, i) => ({ pos: r.position ?? i + 1, name: r.name, value: `${r.points}`, extra: `pts · ${r.unlocked} 🏅` }));
  } else if (mapParam && !selected) {
    // Mapa desconocido: no se consulta nada con él, solo se sugieren parecidos.
    suggestions = maps.map((m) => m.map).filter((m) => m.toLowerCase().includes(mapParam.toLowerCase())).slice(0, 5);
  } else if (selected) {
    mapTotal = selected.players;
    rows = search
      ? (await fetchPlayerPbOnMap(selected.map, search)).map((r) => ({ pos: r.position, name: r.name, value: r.time, extra: `${r.finishes} runs`, total: r.total }))
      : (await fetchMapTop(selected.map, LIMIT)).map((r, i) => ({ pos: i + 1, name: r.name, value: r.time, extra: `${r.finishes} runs` }));
  } else {
    rows = search
      ? (await fetchPlayerRank(search)).map((r) => ({ pos: r.position, name: r.name, value: `${r.points}`, extra: 'pts' }))
      : (await fetchGlobalTop(LIMIT)).map((r, i) => ({ pos: i + 1, name: r.name, value: `${r.points}`, extra: 'pts' }));
  }
  rows = rows.slice(0, LIMIT);
} catch (err) {
  console.error('[ranking] error leyendo la ranking API:', err);
  failed = true;
}

const isMap = Boolean(mapParam) && maps.some((m) => m.map === mapParam);
const unknownMap = Boolean(mapParam) && !isMap;
const mapHref = (m: string) => `/ranking/?map=${encodeURIComponent(m)}`;
const podium = (pos: number) => (pos === 1 ? 'gold' : pos === 2 ? 'silver' : pos === 3 ? 'bronze' : '');

Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<Layout
  title="Ranking Minigames — RandomPicks CS2"
  description="Ranking global de minigames del servidor RandomPicks de CS2: top 20 por puntos y mejores tiempos de cada mapa, en directo."
>
  <nav>
    <div class="nav-inner">
      <a href="/" class="logo-img-link">
        <img src="/random_picks_logo.jpg" alt="RandomPicks" style="height:44px;width:72px;object-fit:cover;object-position:center;border-radius:8px;display:block;" />
      </a>
      <ul class="nav-links">
        <li><a href="/" data-i18n="nav-home">Inicio</a></li>
        <li><a href="/guias/" data-i18n="nav-guides">Guías</a></li>
        <li><a href="/mapas/" data-i18n="nav-maps">Mapas</a></li>
        <li><a href="/novedades/" data-i18n="nav-news">Novedades</a></li>
        <li><a href="https://discord.gg/HSMZT6njnk" target="_blank" rel="noopener" class="nav-discord">Discord</a></li>
        <li><a href="https://ko-fi.com/randompicks" target="_blank" rel="noopener" class="nav-kofi" data-i18n="nav-kofi">☕ Apóyanos</a></li>
      </ul>
      <div class="nav-right">
        <button id="lang-toggle" class="lang-toggle" aria-label="Switch to English" title="Switch to English">
          <span class="lang-globe" aria-hidden="true">🌐</span>
          <span class="lang-es lang-active" id="lang-es">ES</span>
          <span class="lang-sep" aria-hidden="true">|</span>
          <span class="lang-en lang-inactive" id="lang-en">EN</span>
        </button>
        <button class="hamburger" id="hamburger" aria-label="Menú" data-i18n-aria-label="menu-label" aria-controls="mobile-menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      <a href="/" data-i18n="nav-home">Inicio</a>
      <a href="/guias/" data-i18n="nav-guides">Guías</a>
      <a href="/mapas/" data-i18n="nav-maps">Mapas</a>
      <a href="/novedades/" data-i18n="nav-news">Novedades</a>
      <a href="https://discord.gg/HSMZT6njnk" target="_blank" rel="noopener">Discord</a>
      <a href="https://ko-fi.com/randompicks" target="_blank" rel="noopener" data-i18n="nav-kofi">☕ Apóyanos</a>
    </div>
  </nav>

  <div class="rk-bg" aria-hidden="true">
    <div class="rk-orb rk-orb1"></div>
    <div class="rk-orb rk-orb2"></div>
    <div class="rk-grid-overlay"></div>
  </div>

  <main class="ranking-page">
    <header class="rk-header">
      {achievements ? <>
        <div class="section-tag" data-i18n="rk-tag-ach">RANKING DE LOGROS</div>
        <h1 class="rk-title" data-i18n="rk-title-ach">Cazadores de logros</h1>
      </> : <>
        <div class="section-tag" data-i18n="rk-tag">RANKING MINIGAMES</div>
        <h1 class="rk-title" data-i18n="rk-title">Los más rápidos del servidor</h1>
      </>}
      {achievements
        ? <p class="rk-sub" data-i18n="rk-sub-ach">Top 20 por puntos de logros. Desbloquéalos jugando en Minigames y Surf.</p>
        : <p class="rk-sub" data-i18n="rk-sub">Top 20 global por puntos. Elige un mapa para ver solo sus records.</p>}
    </header>

    <div class="rk-tabs" role="tablist">
      <a href="/ranking/" role="tab" aria-selected={!achievements} class={!achievements ? 'active' : ''} data-i18n="rk-tab-times">⏱️ Tiempos</a>
      <a href="/ranking/?view=logros" role="tab" aria-selected={achievements} class={achievements ? 'active' : ''} data-i18n="rk-tab-ach">🏅 Logros</a>
    </div>

    <form class={`rk-filters ${achievements ? 'is-ach' : ''}`} method="get" action="/ranking/">
      {achievements && <input type="hidden" name="view" value="logros" />}
      {!achievements && <label class="rk-field rk-field-map">
        <span class="rk-label" data-i18n="rk-map-label">Mapa</span>
        <select name="map" id="rk-map">
          <option value="" data-i18n="rk-all-maps">🏆 Ranking global</option>
          {maps.map((m) => <option value={m.map} selected={m.map === mapParam}>{m.map}</option>)}
        </select>
      </label>}
      <label class="rk-field rk-field-search">
        <span class="rk-label" data-i18n="rk-search-label">Jugador</span>
        <input type="search" name="q" value={search} maxlength="64" placeholder="Nombre o SteamID64" data-i18n-placeholder="rk-search-ph" />
      </label>
      <div class="rk-actions">
        <button type="submit" class="rk-btn" data-i18n="rk-search-btn">Buscar</button>
        {(search || mapParam) && <a class="rk-clear" href={achievements ? '/ranking/?view=logros' : '/ranking/'} data-i18n="rk-clear">Limpiar</a>}
      </div>
    </form>

    <section class="board" aria-labelledby="board-title">
      <header class="board-head">
        <div>
          <span class={`board-kind ${isMap ? 'is-map' : ''}`}>
            {isMap ? <span data-i18n="rk-kind-map">⏱️ Records del mapa</span>
              : achievements ? <span id="board-title" data-i18n="rk-kind-ach">🏅 Ranking de logros</span>
              : <span id="board-title" data-i18n="rk-kind-global">🏆 Ranking global</span>}
          </span>
          {isMap && <h2 id="board-title" class="board-title">{mapParam}</h2>}
        </div>
        {!failed && rows.length > 0 && (
          <div class="board-meta">
            {search ? (
              <><strong>{rows.length}</strong> <span data-i18n="rk-results">resultados</span></>
            ) : isMap ? (
              <><strong>{rows.length}</strong> / {mapTotal}{' '}<span data-i18n="rk-players">jugadores</span></>
            ) : (
              <>Top <strong>{rows.length}</strong></>
            )}
          </div>
        )}
      </header>

      {failed ? (
        <div class="board-empty is-error">
          <span class="board-empty-icon" aria-hidden="true">⚠️</span>
          <p data-i18n="rk-error">El ranking no está disponible ahora mismo. Vuelve a intentarlo en unos minutos.</p>
        </div>
      ) : unknownMap ? (
        <div class="board-empty">
          <span class="board-empty-icon" aria-hidden="true">🗺️</span>
          <p><span data-i18n="rk-no-map">No hay records para el mapa</span> <code>{mapParam}</code>.</p>
          {suggestions.length > 0 && (
            <div class="board-suggest">
              <span data-i18n="rk-maybe">¿Quizás quisiste decir?</span>
              {suggestions.map((m) => <a href={mapHref(m)}>{m}</a>)}
            </div>
          )}
        </div>
      ) : rows.length === 0 ? (
        <div class="board-empty">
          <span class="board-empty-icon" aria-hidden="true">🔍</span>
          {search
            ? <p><span data-i18n="rk-no-player">Ningún jugador coincide con</span> <code>{search}</code>.</p>
            : <p data-i18n={achievements ? 'rk-no-ach' : 'rk-no-data'}>{achievements ? 'Nadie tiene logros todavía. ¡Sé el primero!' : 'Todavía no hay datos.'}</p>}
        </div>
      ) : (
        <>
          <div class="board-cols" aria-hidden="true">
            <span>#</span>
            <span data-i18n="rk-col-player">Jugador</span>
            <span>{isMap ? <span data-i18n="rk-col-time">Tiempo</span> : <span data-i18n="rk-col-points">Puntos</span>}</span>
          </div>
          <ol class="board-list">
            {rows.map((r, i) => (
              <li class={`row ${podium(r.pos)}`} style={`--i:${i}`}>
                <span class="row-pos">
                  {r.pos <= 3 ? <span class="medal">{r.pos}</span> : <span>{r.pos}</span>}
                  {r.total !== undefined && <small class="row-total">/{r.total}</small>}
                </span>
                {r.name
                  ? <span class="row-name" title={r.name}>{r.name}</span>
                  : <span class="row-name" data-i18n="rk-unknown">Desconocido</span>}
                <span class="row-value">
                  <strong>{r.value}</strong>
                  {r.extra && <small>{r.extra}</small>}
                </span>
              </li>
            ))}
          </ol>
        </>
      )}

      {!failed && !unknownMap && (
        <footer class="board-foot" data-i18n={isMap ? 'rk-foot-map' : achievements ? 'rk-foot-ach' : 'rk-foot-global'}>
          {isMap ? 'Mejor tiempo de cada jugador en este mapa' : achievements ? 'Puntos de logros · 🏅 logros desbloqueados' : 'Puntos por posición relativa en cada mapa'}
        </footer>
      )}
    </section>

    {achievements && (
      <section class="ach-how" aria-labelledby="ach-how-title">
        <h2 id="ach-how-title" data-i18n="ach-how-title">¿Cómo funcionan los logros?</h2>
        <p data-i18n="ach-how-intro">Cada vez que completas un mapa con el cronómetro, el servidor revisa tus logros. Al desbloquear uno ganas sus puntos, suena un aviso y todo el servidor se entera. Tus logros se guardan para siempre y valen igual en Minigames y en Surf.</p>
        <ul class="ach-list">
          <li><strong data-i18n="ach-1-t">🏁 Recorridos</strong> <span data-i18n="ach-1-d">Completa mapas: el primero, 10, 50, 250… y hasta 1000 recorridos.</span></li>
          <li><strong data-i18n="ach-2-t">🗺️ Exploración</strong> <span data-i18n="ach-2-d">Completa mapas distintos, bonus y mapas de tier alto.</span></li>
          <li><strong data-i18n="ach-3-t">⚡ Velocidad</strong> <span data-i18n="ach-3-d">Termina en menos de 1 minuto o de 30 segundos y alcanza 1000 o 2500 u/s.</span></li>
          <li><strong data-i18n="ach-4-t">🥇 Competición</strong> <span data-i18n="ach-4-d">Mejora tus marcas, entra en el top 10 o el podio de un mapa y bate récords del servidor.</span></li>
          <li><strong data-i18n="ach-5-t">🎯 Técnica</strong> <span data-i18n="ach-5-d">Termina con un 90 % de sync o con un estilo distinto al normal.</span></li>
          <li><strong data-i18n="ach-6-t">⏳ Constancia</strong> <span data-i18n="ach-6-d">Horas de juego, saltos, conexiones y maratones sin salir del servidor.</span></li>
          <li><strong data-i18n="ach-7-t">❓ Secretos</strong> <span data-i18n="ach-7-d">Algunos logros están ocultos hasta que los consigues. ¿Los encontrarás?</span></li>
        </ul>
        <p data-i18n="ach-how-points">Los logros más difíciles dan más puntos. El ranking ordena por puntos y, si hay empate, por número de logros.</p>
        <h3 data-i18n="ach-cmd-title">Comandos en el juego</h3>
        <ul class="ach-cmds">
          <li><code>!achievements</code> <span data-i18n="ach-cmd-1">Tus logros y tu progreso</span></li>
          <li><code>!topachievements</code> <span data-i18n="ach-cmd-2">Los mejores jugadores por puntos de logros</span></li>
          <li><code>!logroshud</code> <span data-i18n="ach-cmd-3">Muestra u oculta el seguimiento de logros en pantalla</span></li>
        </ul>
      </section>
    )}

    <p class="rk-footnote">
      <span data-i18n="rk-footnote">Se actualiza cada minuto · Conéctate y entra en el ranking:</span>
      <code>connect cs2.randompicks.es:27015</code>
    </p>
    <p class="rk-footnote rk-legal"><a href="/privacidad/" data-i18n="footer-privacy">Privacidad</a></p>
  </main>

  <Analytics />

  <script is:inline>
    var t = {
      es: {
        'ad-label': 'Publicidad', 'footer-privacy': 'Privacidad',
        'nav-home': 'Inicio', 'nav-guides': 'Guías', 'nav-maps': 'Mapas', 'nav-news': 'Novedades', 'nav-kofi': '☕ Apóyanos', 'menu-label': 'Menú', 'rk-tag': 'RANKING MINIGAMES', 'rk-title': 'Los más rápidos del servidor',
        'rk-sub': 'Top 20 global por puntos. Elige un mapa para ver solo sus records.',
        'rk-map-label': 'Mapa', 'rk-search-label': 'Jugador',
        'rk-search-ph': 'Nombre o SteamID64', 'rk-all-maps': '🏆 Ranking global', 'rk-search-btn': 'Buscar', 'rk-clear': 'Limpiar',
