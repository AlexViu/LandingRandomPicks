---
import { AADS_UNIT, ADSENSE_CLIENT } from '../lib/ads';

interface Props {
  unit: string;
}
const { unit } = Astro.props;
const aads = Boolean(AADS_UNIT);
const enabled = aads || Boolean(ADSENSE_CLIENT && unit);
---
{enabled && (
  <aside class="ad-banner">
    <span class="ad-label" data-i18n="ad-label">Publicidad</span>
    {aads ? (
      <iframe
        class="aads"
        data-aa={AADS_UNIT}
        src={`https://acceptable.a-ads.com/${AADS_UNIT}/?size=Adaptive`}
        title="Publicidad"
        loading="lazy"
      ></iframe>
    ) : (
      <>
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={ADSENSE_CLIENT}
          data-ad-slot={unit}
          data-ad-format="horizontal"
          data-full-width-responsive="false"
        ></ins>
        <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
      </>
    )}
  </aside>
)}

<style>
  .ad-banner { max-width: 970px; margin: 32px auto; padding: 0 24px; text-align: center; }
  .ad-label {
    display: block; margin-bottom: 6px;
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
  }
  /* Hueco reservado para que la página no salte cuando carga el anuncio. */
  .ad-banner ins { min-height: 90px; }
  .ad-banner .aads { display: block; width: 70%; height: 90px; margin: auto; border: 0; padding: 0; overflow: hidden; }
  @media (max-width: 600px) {
    .ad-banner { padding: 0 16px; }
    .ad-banner ins { min-height: 100px; }
    .ad-banner .aads { width: 100%; height: 100px; }
  }
</style>
